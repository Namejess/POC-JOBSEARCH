# Configuration du serveur
PORT=3000
NODE_ENV=development

# Configuration CORS
FRONTEND_URL=http://localhost:4200

# Configuration du scraping
SCRAPING_USER_AGENT=JobSearchMVP/1.0 (+contact@example.com)
SCRAPING_MAX_CONCURRENCY=1
SCRAPING_TIMEOUT_MS=300000
SCRAPING_MAX_REQUESTS_PER_MINUTE=20

# Configuration France Travail API
# Obtenir les credentials sur : https://www.emploi-store-dev.fr/portail-developpeur
# Créer une application et récupérer Client ID et Client Secret
FRANCE_TRAVAIL_CLIENT_ID=votre_client_id
FRANCE_TRAVAIL_CLIENT_SECRET=votre_client_secret

# Configuration SMTP pour l'envoi d'emails via Resend
# Resend est gratuit jusqu'à 100 emails/jour (parfait pour le MVP)
# 1. Créer un compte gratuit : https://resend.com/signup
# 2. Créer une clé API : https://resend.com/api-keys
# 3. Copier la clé API et la coller dans SMTP_PASS
# IMPORTANT : SMTP_USER doit rester "resend" (ne pas changer)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_votre_cle_api_resend
SMTP_FROM=votre_email@example.com
	

